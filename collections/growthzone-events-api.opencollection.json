{
  "opencollection": "1.0.0",
  "info": {
    "name": "GrowthZone REST Certifications Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events by date range and status (Modeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.growthzoneapp.com/api/events",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Modeled from the GrowthZone ChamberMaster/MemberZone event feed (legacy base api.micronetonline.com/v1/associations({id})/events/details). Returns events filtered by date range and status for calendar embeds."
        },
        {
          "info": {
            "name": "Get event details (Modeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.growthzoneapp.com/api/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get event details (Modeled)"
        }
      ]
    }
  ],
  "bundled": true
}